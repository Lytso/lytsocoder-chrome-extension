{
  "manifest_version": 3,
  "name": "LytsoCoder Browser Bridge",
  "short_name": "LytsoCoder",
  "version": "1.0.0",
  "description": "Connects LytsoCoder AI agents to your browser: isolated in the LytsoCoder tab group with explicit per-tab approval.",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LytsoCoder",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}